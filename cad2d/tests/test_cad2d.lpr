program test_cad2d;
{$mode objfpc}{$H+}{$codepage utf8}
uses Interfaces, Forms, Classes, SysUtils, Types, Math, LCLType, Menus, fpjson, ea_workflow, cad2d_main;
var W: TWorkflow; G: TGUID; TestPath, Admin, Restricted, Viewer, RID, VID, Own, Other: string; TaskData: TJSONObject;
  F: TCADMainForm; Checks: Integer; P, S: TPoint; Before: string; K: Word; I: Integer;
procedure Check(OK: Boolean; const Msg: string);
begin Inc(Checks); if not OK then raise Exception.Create(Msg); end;
begin
  Application.Initialize;
  try
    F := TCADMainForm.Create(nil);
    try
      Check(F.Menu is TMainMenu, 'menu principal nativo no topo da janela');
      Check(F.Menu = F.FMainMenu, 'menu associado ao formulario');
      Check(F.Menu.Items.Count = 9, 'nove menus superiores');
      Check(F.Menu.Items[0].Count = 7, 'comandos de arquivo');
      Check(F.Menu.Items[0].Items[0].Hint = 'NEW', 'comando do submenu');
      Check(Assigned(F.Menu.Items[0].Items[0].OnClick), 'acao do submenu');
      Check(Length(F.FLines) > 0, 'exemplo 2D');
      Check(F.FHistory.Limit = 60, 'historico CHATGPT');
      Check(Pos('Sem título.eacad', F.Caption) > 0, 'titulo real');
      for I := 0 to 3 do begin
        F.RibbonTabClick(F.FRibbonTabs[I]);
        Check(F.FRibbonGroups[4].Visible, 'camada acessivel nas abas');
        Check(F.FRibbonTabs[I].Font.Style <> [], 'aba ativa');
      end;
      F.FZoom := 2; F.FPanX := -300; F.FPanY := 127;
      P := Point(-42, 93); S := F.WorldToScreen(P);
      Check(F.ScreenToWorld(S.X,S.Y) = P, 'transformacao 2D reversivel');
      S := Point(150,100); P := F.ScreenToWorld(S.X,S.Y);
      F.ZoomAt(S,1.25);
      Check(F.ScreenToWorld(S.X,S.Y) = P, 'zoom ancorado no cursor');
      F.ZoomExtents(nil);
      Check(F.FZoom > 0, 'zoom enquadrar');
      F.FLayerVisible[0] := False; F.SyncLayerPanel;
      Check(not F.FLayerList.Checked[0], 'visibilidade sincronizada');
      F.FSelected := -1; F.SelectObjectAt(Point(160,80));
      Check((F.FSelected < 0) or (F.FLines[F.FSelected].Layer <> 0), 'camada oculta nao selecionavel');
      F.FLayerVisible[0] := True; F.FLayerLocked[0] := True;
      F.SelectObjectAt(Point(160,80));
      Check((F.FSelected < 0) or (F.FLines[F.FSelected].Layer <> 0), 'camada bloqueada nao editavel');
      F.FLayerLocked[0] := False;
      Before := F.Snapshot; F.RecordChange;
      F.AddSegmentEx(Point(10,10),Point(50,10),0,0,0,0,0);
      Check(F.Snapshot <> Before, 'adicao de geometria');
      F.UndoHistory(nil); Check(F.Snapshot = Before, 'desfazer CHATGPT');
      F.RedoHistory(nil); Check(F.Snapshot <> Before, 'refazer CHATGPT');
      F.UndoHistory(nil); F.RecordChange;
      Check(not F.FHistory.CanRedo, 'nova edicao limpa refazer');
      F.ExecuteCommandString('L'); Check(F.FToolSelect.ItemIndex = 0, 'alias L');
      F.ExecuteCommandString('REC'); Check(F.FToolSelect.ItemIndex = 1, 'alias REC');
      F.ExecuteCommandString('C'); Check(F.FToolSelect.ItemIndex = 6, 'alias C');
      F.ExecuteCommandString('JAA'); Check(F.FToolSelect.ItemIndex = 11, 'janela alta 2D');
      K := VK_F7; F.FormKeyDownHandler(nil,K,[]); Check(not F.FShowGrid, 'F7 grade');
      K := VK_F8; F.FormKeyDownHandler(nil,K,[]); Check(F.FOrthoEnabled, 'F8 ortogonal');
      K := VK_F9; F.FormKeyDownHandler(nil,K,[]); Check(not F.FSnapEnabled, 'F9 snap');
      K := Ord('1'); F.FormKeyDownHandler(nil,K,[ssCtrl]); Check(not F.FLayerPanel.Visible, 'Ctrl+1 camadas');
      F.ExecuteCommandString('AJUDA'); Check(Pos('LINHA', F.FCmdHistoryMemo.Text)>0, 'ajuda');
      Check(F.FSideBar <> nil, 'barra lateral auxiliar');
      F.RibbonTabClick(F.FRibbonTabs[4]);
      Check(F.FRibbonGroups[7].Visible, 'aba Gestao');
      CreateGUID(G); TestPath := IncludeTrailingPathDelimiter(GetTempDir)+'ea-cad-test-'+GUIDToString(G)+'.json';
      W := TWorkflow.Create(TestPath);
      Admin := W.Bootstrap('admin','Admin','TesteAdmin-123!');
      RID := W.SaveUser(Admin,'','restrito','Restrito','TesteRestrito-123!','restricted',True);
      VID := W.SaveUser(Admin,'','leitor','Leitor','TesteLeitor-123!','viewer',True);
      Own := W.SaveTask(Admin,'','Minha tarefa','Detalhes',RID,'','','');
      TaskData := W.User(Admin);
      try Other := W.SaveTask(Admin,'','Outra tarefa','Oculta',TaskData.Get('id',''),'','',''); finally TaskData.Free; end;
      Restricted := W.Login('restrito','TesteRestrito-123!'); Viewer := W.Login('leitor','TesteLeitor-123!');
      F.FWorkflow.Free; F.FWorkflow := W;
      F.FWorkflowToken := Restricted; F.FTaskID := Own;
      F.TaskViewClick(nil);
      Check(F.FWorkflowView <> nil, 'visao de tarefa');
      Check(F.FWorkflowView.SelectedID = Own, 'tarefa propria selecionada');
      Check(F.FWorkflowView.Visible and not F.FCanvas.Visible, 'alternancia 2D tarefa');
      F.DrawingViewClick(F.FWorkflowView);
      Check(F.FCanvas.Visible and not F.FWorkflowView.Visible, 'retorno a tela 2D');
      Check(F.WorkflowEditAllowed, 'restrito edita propria tarefa');
      F.FTaskID := Other; Check(not F.WorkflowEditAllowed, 'restrito bloqueado em tarefa alheia');
      F.FTaskID := Own; F.FWorkflowToken := Viewer;
      Check(not F.WorkflowEditAllowed, 'visualizador somente leitura no CAD');
      Before := F.Snapshot; F.FSelected := 0; F.DeleteSelected(nil);
      Check(F.Snapshot = Before, 'visualizador nao exclui geometria');
      F.UndoHistory(nil); Check(F.Snapshot = Before, 'visualizador nao altera pelo historico');
      F.FWorkflowToken := ''; F.FTaskID := ''; F.FDirty := False;
      WriteLn(Checks, ' verificacoes CAD 2D, 0 falhas');
    finally F.Free; if TestPath <> '' then begin DeleteFile(TestPath); DeleteFile(TestPath+'.lock'); end; end;
  except on E: Exception do begin WriteLn('FALHA: ',E.Message); Halt(1); end; end;
end.
