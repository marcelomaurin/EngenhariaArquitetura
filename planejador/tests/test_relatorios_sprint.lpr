program test_relatorios_sprint;
{$mode objfpc}{$H+}{$codepage utf8}
uses Classes,SysUtils,DateUtils,fpjson,plan_tipos,plan_recursos,plan_apontamentos,plan_sprints,plan_documento,plan_cronograma,plan_acompanhamento,plan_relatorios_sprint,plan_json;
var P,Q: TPLProjeto; C,C2,Invalid: TPLCronograma; A,B,Done,OldDone,Unassigned,Future: TPLTarefa; Ana,Bruno,Carla,Team: TPLRecurso; S: TPLSprint;
 Rel,Filtered: TPLRelatorioSprint; Alloc: TPLAlocacoes; Day: TDateTime; IDs: array[0..6] of string;
 I,J,N,Checks: Integer; Failed: Boolean; G: TGUID; Path: string; L: TStringList; O: TJSONObject;
procedure Check(Value: Boolean; const Text: string);
begin Inc(Checks); if not Value then raise Exception.Create(Text); end;
function Person(const Name,UserID: string): TPLRecurso;
begin Result:=P.NovoRecurso; Result.Tipo:=prtPessoa; Result.Nome:=Name; Result.UsuarioID:=UserID; P.AdicionarRecurso(Result); end;
function Task(const Name: string; Start: TDateTime; R: TPLRecurso): TPLTarefa;
begin Result:=P.NovaTarefa(Name); Result.InicioSolicitado:=Start; if R<>nil then begin Result.ExecutorID:=R.UsuarioID; Result.ExecutorNome:=R.Nome; Result.Responsavel:=R.UsuarioID; end; end;
function UserIndex(ReportData: TPLRelatorioSprint; const ResourceID: string): Integer;
var K: Integer;
begin Result:=-1; for K:=0 to High(ReportData.Usuarios) do if SameText(ReportData.Usuarios[K].RecursoID,ResourceID) then Exit(K); end;
begin
 DefaultSystemCodePage:=CP_UTF8; SetMultiByteConversionCodePage(CP_UTF8); Checks:=0;
 P:=TPLProjeto.Create; Q:=TPLProjeto.Create; C:=TPLCronograma.Create; C2:=TPLCronograma.Create; Invalid:=TPLCronograma.Create; L:=TStringList.Create; Rel:=nil; Filtered:=nil; CreateGUID(G); Path:=GetTempDir(False)+'ea-rel-sprint-'+GUIDToString(G);
 try
  Day:=EncodeDate(2026,11,9); P.Novo('UBS <teste> — relatório fictício',Day-7); P.Calendario.Clear; P.Calendario.SetStandard;
  Ana:=Person('<Ana & equipe>','ana'); Bruno:=Person('Bruno','bruno'); Carla:=Person('Carla','carla'); Team:=P.NovoRecurso; Team.Nome:='Equipe agregada'; Team.Tipo:=prtEquipe; P.AdicionarRecurso(Team);
  SetLength(Bruno.Ausencias,1); Bruno.Ausencias[0].De:=Day+1; Bruno.Ausencias[0].Ate:=Day+1;
  A:=Task('Pendência anterior',Day-7,Ana); A.Progresso:=25;
  B:=Task('=1+1',Day,Bruno); B.Situacao:=plsEmAndamento; B.Progresso:=50;
  Done:=Task('Concluída do período',Day+1,Ana); PLAlterarStatus(P,Done,plsConcluida);
  OldDone:=Task('Concluída antiga com trabalho no período',Day-7,Bruno); PLAlterarStatus(P,OldDone,plsConcluida);
  Unassigned:=Task('Equipe sem pessoa indicada',Day+1,nil); Future:=Task('Fora do período',Day+14,Ana);
  SetLength(Alloc,1); Alloc[0].RecursoID:=Ana.ID; Alloc[0].Unidades:=0.5; Alloc[0].Direcao:=prdUso; P.DefinirAlocacoes(A,Alloc);
  Alloc[0].RecursoID:=Team.ID; Alloc[0].Unidades:=1; P.DefinirAlocacoes(Unassigned,Alloc);
  C.Calcular(P); Check(C.Valido,'cronograma válido'); S:=P.NovaSprint('Sprint <1>',Day,Day+6); PLAtualizarSprint(P,C,S);
  Check(not S.Contem(OldDone.ID),'concluída antiga começa fora da sprint');
  Rel:=PLGerarRelatorioSprint(P,C,S,'',Day+3); Check(Rel.ApontadoMin=0,'sem apontamento não inventa horas realizadas'); Rel.Free; Rel:=nil;
  IDs[0]:=P.SalvarApontamento('',A.ID,Ana.ID,Day,120,'Levantamento');
  IDs[1]:=P.SalvarApontamento('',Done.ID,Ana.ID,Day+1,240,'Desenho concluído');
  IDs[2]:=P.SalvarApontamento('',B.ID,Bruno.ID,Day,60,'Desenho');
  IDs[3]:=P.SalvarApontamento('',B.ID,Carla.ID,Day,90,'=HYPERLINK("teste")');
  IDs[4]:=P.SalvarApontamento('',OldDone.ID,Bruno.ID,Day+6,60,'Revisão no último dia');
  IDs[5]:=P.SalvarApontamento('',A.ID,Ana.ID,Day-1,60,'Antes da sprint');
  IDs[6]:=P.SalvarApontamento('',B.ID,Bruno.ID,Day+7,30,'Depois da sprint');
  Check(B.Progresso=50,'apontamento não altera progresso'); Check(P.CustoComputadoProjeto=0,'apontamento não lança custo automaticamente');
  PLAtualizarSprints(P,C); Check(S.Contem(OldDone.ID),'atividade real no período associa tarefa concluída à sprint'); Check(not S.Contem(Future.ID),'tarefa futura sem atividade permanece fora');
  Rel:=PLGerarRelatorioSprint(P,C,S,'',Day+3);
  Check(Rel.Total=5,'escopo único da sprint'); Check((Rel.Pendentes=3) and (Rel.Concluidas=2),'pendentes e concluídas separados'); Check(Rel.Atrasadas=3,'atrasos por data de referência');
  Check(Rel.ApontadoMin=570,'horas realizadas incluem só datas dentro da sprint'); Check(Length(Rel.Horas)=5,'apontamentos fora do período não entram'); Check(Rel.RestanteMin=900,'esforço restante estimado do escopo');
  I:=UserIndex(Rel,Ana.ID); Check(I>=0,'usuária encontrada');
  Check((Rel.Usuarios[I].Tarefas=2) and (Rel.Usuarios[I].Pendentes=1) and (Rel.Usuarios[I].Concluidas=1),'contagens por pessoa sem duplicar executor e alocação');
  Check(Rel.Usuarios[I].ApontadoMin=360,'horas da usuária corretas'); Check(Rel.Usuarios[I].PrevistoPeriodoMin=660,'planejada considera dedicação parcial e saldo de pendência antiga');
  Check(Rel.Usuarios[I].RestanteEstimadoMin=180,'saldo usa progresso e dedicação'); Check(Rel.Usuarios[I].ConcluidoEstimadoMin=540,'concluída estimada é distinta de horas realizadas'); Check(Rel.Usuarios[I].CapacidadeMin=2400,'capacidade de cinco dias de oito horas');
  I:=UserIndex(Rel,Bruno.ID); Check(Rel.Usuarios[I].ApontadoMin=120,'último dia da sprint é incluído'); Check(Rel.Usuarios[I].CapacidadeMin=1920,'ausência reduz capacidade');
  I:=UserIndex(Rel,Carla.ID); Check(I>=0,'colaboradora por apontamento aparece sem ser executora'); Check((Rel.Usuarios[I].Tarefas=1) and (Rel.Usuarios[I].ApontadoMin=90),'atividade de colaboradora contabilizada uma vez'); Check(Rel.Usuarios[I].RestanteEstimadoMin=0,'não inventa atribuição à colaboradora');
  I:=UserIndex(Rel,''); Check((I>=0) and (Rel.Usuarios[I].Pendentes=1),'tarefa de equipe sem pessoa é explícita'); Check(Rel.Usuarios[I].ApontadoMin=0,'equipe não é distribuída ficticiamente');
  Filtered:=PLGerarRelatorioSprint(P,C,S,Ana.ID,Day+3); Check((Filtered.Total=2) and (Filtered.ApontadoMin=360),'filtro de usuária limita tarefas e horas'); Check(Length(Filtered.Usuarios)=1,'filtro de pessoa não revela totais de outras pessoas'); Filtered.Free; Filtered:=nil;
  Filtered:=PLGerarRelatorioSprint(P,C,S,Carla.ID,Day+3); Check((Filtered.Total=1) and (Filtered.ApontadoMin=90),'filtro inclui contribuição real sem alocação formal'); Filtered.Free; Filtered:=nil;
  Filtered:=PLGerarRelatorioSprint(P,C,S,Team.ID,Day+3); Check((Filtered.Total=1) and (Filtered.ApontadoMin=0),'filtro de equipe limita o escopo sem simular horas'); Filtered.Free; Filtered:=nil;
  N:=Length(P.Apontamentos); Failed:=False; try P.SalvarApontamento('',A.ID,Ana.ID,Day,1321,'Excesso'); except on E: Exception do Failed:=True; end; Check(Failed and (Length(P.Apontamentos)=N),'limite diário preserva os registros existentes');
  Failed:=False; try P.SalvarApontamento('',A.ID,Ana.ID,Day,0,'Zero'); except on E: Exception do Failed:=True; end; Check(Failed,'horas zero recusadas');
  Failed:=False; try P.SalvarApontamento('',A.ID,Ana.ID,0,60,'Sem data'); except on E: Exception do Failed:=True; end; Check(Failed,'data obrigatória');
  Failed:=False; try P.SalvarApontamento('','inexistente',Ana.ID,Day,60,''); except on E: Exception do Failed:=True; end; Check(Failed,'tarefa inexistente recusada');
  Failed:=False; try P.SalvarApontamento('',A.ID,Team.ID,Day,60,''); except on E: Exception do Failed:=True; end; Check(Failed,'horas de pessoa não são lançadas em equipe agregada');
  P.SalvarApontamento(IDs[0],A.ID,Ana.ID,Day,180,'Corrigido'); Check(Length(P.Apontamentos)=N,'editar não duplica apontamento'); P.SalvarApontamento(IDs[0],A.ID,Ana.ID,Day,120,'Levantamento');
  Failed:=False; try P.SalvarApontamento(IDs[0],A.ID,Ana.ID,Day,-1,'Inválido'); except on E: Exception do Failed:=True; end; Check(Failed and (P.Apontamentos[P.ApontamentoIndice(IDs[0])].Minutos=120),'edição inválida preserva o valor original');
  Failed:=False; try P.ExcluirTarefa(P.IndiceDe(A.ID)); except on E: Exception do Failed:=True; end; Check(Failed,'tarefa com horas não é apagada silenciosamente');
  Failed:=False; try P.ExcluirRecurso(P.RecursoIndice(Carla.ID)); except on E: Exception do Failed:=True; end; Check(Failed,'pessoa com horas não é apagada');
  Carla.Tipo:=prtEquipamento; Failed:=False; try P.ValidarRecursos; except on E: Exception do Failed:=True; end; Check(Failed,'alterar tipo não quebra identidade de apontamentos'); Carla.Tipo:=prtPessoa;
  PLRelatorioSprintHTML(Rel,Path+'.html'); PLRelatorioSprintPendenciasCSV(Rel,Path+'-pendencias.csv'); PLRelatorioSprintUsuariosCSV(Rel,Path+'-usuarios.csv'); PLRelatorioSprintHorasCSV(Rel,Path+'-horas.csv');
  L.LoadFromFile(Path+'.html'); Check(Pos('&lt;Ana &amp; equipe&gt;',L.Text)>0,'HTML escapa nomes'); Check(Pos('<svg',L.Text)>0,'HTML inclui gráfico de carga'); Check(Pos('Tarefas concluídas',L.Text)>0,'concluídas identificáveis no relatório');
  L.LoadFromFile(Path+'-pendencias.csv'); Check(Pos(#39+'=1+1',L.Text)>0,'nome de tarefa não executa fórmula CSV'); Check(Pos('Concluída do período',L.Text)=0,'CSV de pendências exclui concluídas');
  L.LoadFromFile(Path+'-horas.csv'); Check(Pos(#39+'=HYPERLINK',L.Text)>0,'observação não executa fórmula CSV'); Check(Pos('Antes da sprint',L.Text)=0,'CSV não vaza horas fora do período');
  PLSalvarProjeto(P,Path+'.json'); PLCarregarProjeto(Q,Path+'.json'); Check(Length(Q.Apontamentos)=7,'horas persistem com os dados do projeto'); C2.Calcular(Q); Filtered:=PLGerarRelatorioSprint(Q,C2,Q.Sprints[0],'',Day+3); Check(Filtered.ApontadoMin=570,'relatório após reabrir é consistente'); Filtered.Free; Filtered:=nil;
  O:=PLProjetoParaJSON(P); try O.Arrays['apontamentos'].Objects[0].Delete('resource_id'); O.Arrays['apontamentos'].Objects[0].Add('resource_id','inexistente'); L.Text:=O.AsJSON; L.SaveToFile(Path+'.json'); finally O.Free; end;
  Failed:=False; try PLCarregarProjeto(Q,Path+'.json'); except on E: Exception do Failed:=True; end; Check(Failed and (Length(Q.Apontamentos)=7),'arquivo com horas órfãs não substitui o projeto ativo');
  O:=PLProjetoParaJSON(P); try O.Delete('apontamentos'); PLProjetoDeJSON(Q,O); finally O.Free; end; Check(Length(Q.Apontamentos)=0,'projeto antigo abre sem inventar horas');
  Failed:=False; try Filtered:=PLGerarRelatorioSprint(P,C,nil); except on E: Exception do Failed:=True; end; Check(Failed,'relatório exige sprint');
  Failed:=False; try Filtered:=PLGerarRelatorioSprint(P,Invalid,S); except on E: Exception do Failed:=True; end; Check(Failed,'relatório exige cronograma válido');
  Failed:=False; try Filtered:=PLGerarRelatorioSprint(P,C,S,'desconhecido'); except on E: Exception do Failed:=True; end; Check(Failed,'filtro inexistente não vira todos silenciosamente');
  P.Sprints.Delete(0); Check(Length(P.Apontamentos)=7,'excluir sprint preserva horas'); S:=P.NovaSprint('Nova',Day,Day+6); PLAtualizarSprint(P,C,S); Check(S.Contem(OldDone.ID),'trabalho realizado continua associado pelo período após recriar sprint');
  P.ExcluirApontamento(IDs[3]); Check(Length(P.Apontamentos)=6,'apontamento pode ser corrigido por remoção explícita');
  WriteLn(Checks,' verificacoes de relatorios de sprint e apontamentos, 0 falhas');
 finally Filtered.Free; Rel.Free; L.Free; Invalid.Free; C2.Free; C.Free; Q.Free; P.Free; DeleteFile(Path+'.html'); DeleteFile(Path+'-pendencias.csv'); DeleteFile(Path+'-usuarios.csv'); DeleteFile(Path+'-horas.csv'); DeleteFile(Path+'.json'); end;
end.
