program test_sprints;
{$mode objfpc}{$H+}{$codepage utf8}
uses Classes,SysUtils,DateUtils,fpjson,ea_money,plan_tipos,plan_recursos,plan_sprints,
 plan_documento,plan_cronograma,plan_json,plan_acompanhamento;
var P,Q: TPLProjeto; C: TPLCronograma; A,B,T,F,E,Milestone,NewTask: TPLTarefa;
 S,S2: TPLSprint; R,Equipment: TPLRecurso; Items: TPLAlocacoes; Indices: TPLTaskIndices;
 Weeks: TPLCustosSemanais; Day,D1,D2,D3: TDateTime; Checks,I,N: Integer; Failed,Carry: Boolean;
 O: TJSONObject; L: TStringList; G: TGUID; Path,Raw: string; Stream: TFileStream;
procedure Check(V: Boolean; const Text: string);
begin Inc(Checks); if not V then raise Exception.Create(Text); end;
function Task(const Name: string; Start: TDateTime): TPLTarefa;
begin Result:=P.NovaTarefa(Name); Result.InicioSolicitado:=Start; end;
function AddResource(const Name,UID: string; Kind: TPLRecursoTipo): TPLRecurso;
begin Result:=P.NovoRecurso; Result.Nome:=Name; Result.UsuarioID:=UID; Result.Tipo:=Kind; P.AdicionarRecurso(Result); end;
begin
 DefaultSystemCodePage:=CP_UTF8; SetMultiByteConversionCodePage(CP_UTF8); Checks:=0;
 P:=TPLProjeto.Create; Q:=TPLProjeto.Create; C:=TPLCronograma.Create; L:=TStringList.Create; CreateGUID(G); Path:=GetTempDir(False)+'ea-sprints-'+GUIDToString(G);
 try
  Day:=EncodeDate(2026,11,9); P.Novo('<hosp&A>',Day-7); P.Calendario.Clear; P.Calendario.Set24Hours;
  Check(Length(PLCustosPorSemana(P,Day))=0,'sem apuração não há histórico inventado');
  A:=Task('Atrasada',Day-7); A.ExecutorID:='u1'; A.ExecutorNome:='Usuário 1';
  B:=Task('Anterior concluída',Day-7); PLAlterarStatus(P,B,plsConcluida);
  T:=Task('Tarefa do período',Day); T.ExecutorID:='u2'; T.ExecutorNome:='Usuário 2';
  F:=Task('Futura',Day+14); E:=Task('Atravessa o início',Day-1); E.Duracao.Minutes:=1920;
  Milestone:=P.NovaTarefa('Marco no início',True); Milestone.InicioSolicitado:=Day;
  R:=AddResource('Usuário 1','u1',prtPessoa); Equipment:=AddResource('Estação CAD','',prtEquipamento);
  SetLength(Items,1); Items[0].RecursoID:=R.ID; Items[0].Unidades:=0.25; Items[0].Direcao:=prdUso; P.DefinirAlocacoes(E,Items);
  Items[0].RecursoID:=Equipment.ID; Items[0].Unidades:=1; P.DefinirAlocacoes(Milestone,Items);
  C.Calcular(P); Check(C.Valido,'cronograma usado na composição de sprint');
  S:=P.NovaSprint('Sprint 1',Day,Day+6); Check(PLAtualizarSprint(P,C,S),'sprint preenchida automaticamente');
  Check(Length(S.Items)=4,'inclui atrasada, tarefa do período, tarefa em curso e marco');
  Check(S.Contem(A.ID),'pendente anterior incluída'); Check(not S.Contem(B.ID),'concluída de período anterior não é trazida'); Check(not S.Contem(F.ID),'tarefa futura fora da sprint');
  Carry:=False; for I:=0 to High(S.Items) do if S.Items[I].TaskID=A.ID then Carry:=S.Items[I].PendenteAnterior;
  Check(Carry,'pendente anterior identificada'); Carry:=True; for I:=0 to High(S.Items) do if S.Items[I].TaskID=Milestone.ID then Carry:=S.Items[I].PendenteAnterior;
  Check(not Carry,'marco no começo pertence ao período, sem atraso artificial');
  Check(not PLAtualizarSprint(P,C,S),'atualização sem duplicações é idempotente');
  Indices:=PLTarefasTOdo(P,S,R.ID); Check(Length(Indices)=2,'filtro de pessoa inclui executor e alocação explícita');
  Indices:=PLTarefasTOdo(P,S,Equipment.ID); Check((Length(Indices)=1) and (P[Indices[0]]=Milestone),'filtro de equipamento');
  Indices:=PLTarefasTOdo(P,S,'inexistente'); Check(Length(Indices)=0,'filtro desconhecido não mostra tarefas alheias');
  Indices:=PLTarefasTOdo(P,S,''); Check(Length(Indices)=4,'todos os recursos respeita a sprint selecionada');
  NewTask:=Task('Nova tarefa inserida depois',Day+2); C.Calcular(P); PLAtualizarSprints(P,C); Check(S.Contem(NewTask.ID),'nova tarefa do período entra automaticamente');
  PLAlterarStatus(P,A,plsConcluida); PLAtualizarSprints(P,C); Check(S.Contem(A.ID),'concluída permanece na sprint onde foi executada'); Check(A.Progresso=100,'conclusão no TO-DO ajusta progresso');
  S2:=P.NovaSprint('Sprint 2',Day+7,Day+13); PLAtualizarSprint(P,C,S2); Check(not S2.Contem(A.ID),'concluída não retorna no próximo período'); Check(S2.Contem(T.ID),'pendente do período anterior passa à próxima sprint');
  Check(not S2.Contem(F.ID),'início depois da sprint não é antecipado');
  Failed:=False; try P.NovaSprint('Repetida',Day,Day+6); except on Ex: Exception do Failed:=True; end; Check(Failed,'período de sprint duplicado recusado');
  Failed:=False; try P.NovaSprint('Invertida',Day+10,Day); except on Ex: Exception do Failed:=True; end; Check(Failed,'período invertido recusado');
  P.ExcluirTarefa(P.IndiceDe(NewTask.ID)); Check(Length(S.Items)=4,'exclusão de tarefa limpa referências da sprint');
  SetLength(A.Custos,1); A.Custos[0].Nome:='Serviço'; A.Custos[0].Quantidade:=1; A.Custos[0].ValorUnitarioCentavos:=10000; A.Custos[0].Contabilizado:=False;
  SetLength(T.Custos,1); T.Custos[0].Nome:='Material'; T.Custos[0].Quantidade:=1; T.Custos[0].ValorUnitarioCentavos:=2000; T.Custos[0].Contabilizado:=True;
  Check(P.CustoPrevistoProjeto=12000,'previsto automático agrega tarefas'); Check(P.CustoComputadoProjeto=2000,'computado agrega somente itens contabilizados');
  P.OrcamentoFixado:=True; P.OrcamentoCentavos:=10000; Check(P.CustoPrevistoProjeto=10000,'orçamento fixado é independente da composição atual');
  D1:=EncodeDate(2026,10,5); D2:=D1+7; D3:=D1+21;
  P.RegistrarCustos(D1); A.Custos[0].Contabilizado:=True; P.RegistrarCustos(D2);
  Check(P.CustoComputadoProjeto>P.CustoPrevistoProjeto,'computado pode ultrapassar orçamento previsto fixado');
  T.Custos[0].Contabilizado:=False; P.RegistrarCustos(D3); Check(not P.RegistrarCustos(D3),'mesma apuração é idempotente');
  P.OrcamentoCentavos:=15000; Check(P.RegistrarCustos(D3),'alteração no mesmo dia atualiza apuração sem duplicar'); Check(Length(P.HistoricoCustos)=3,'três datas de apuração preservadas');
  Weeks:=PLCustosPorSemana(P,D3+5); Check(Length(Weeks)=4,'relatório contém semanas contínuas');
  Check(not Weeks[0].TemAnterior,'primeira semana é base inicial, sem gasto retroativo fictício');
  Check(Weeks[0].Previsto=10000,'histórico preserva orçamento anterior'); Check(Weeks[1].Computado=12000,'custo computado da segunda semana');
  Check(Weeks[1].Desvio=2000,'elevação acima do orçamento calculada'); Check(Weeks[1].DeltaComputado=10000,'incremento semanal computado calculado');
  Check(not Weeks[2].TemApuracao,'semana sem registro identificada'); Check((Weeks[2].Computado=12000) and (Weeks[2].DeltaComputado=0),'sem registro mantém valores sem inventar custo');
  Check(Weeks[3].DeltaComputado=-2000,'correção de custo aparece como redução'); Check(Weeks[3].DeltaPrevisto=5000,'revisão de orçamento aparece na semana correta');
  PLExportarCustosHTML(P,Weeks,Path+'.html'); L.LoadFromFile(Path+'.html'); Check(Pos('&lt;hosp&amp;A&gt;',L.Text)>0,'título de projeto escapado no HTML'); Check(Pos('<polyline',L.Text)>0,'relatório inclui gráfico');
  PLExportarCustosCSV(P,Weeks,Path+'.csv'); L.LoadFromFile(Path+'.csv'); Check(Pos('Variação semanal computado',L.Text)>0,'CSV inclui variação semanal'); Check(Pos('Sem nova apuração',L.Text)>0,'CSV distingue lacunas');
  Stream:=TFileStream.Create(Path+'.csv',fmOpenRead); try SetLength(Raw,3); Stream.ReadBuffer(Raw[1],3); Check(Raw=#$EF#$BB#$BF,'CSV UTF8 com BOM'); finally Stream.Free; end;
  Check(EAMoneyParse('90.000.000.000.000,00',9000000000000000)=9000000000000000,'orçamento total suporta o limite do projeto');
  PLSalvarProjeto(P,Path+'.json'); PLCarregarProjeto(Q,Path+'.json'); Check(Q.Sprints.Count=2,'sprints persistem'); Check(Q.Sprints[0].Contem(A.ID),'participação de tarefa concluída persiste'); Check(Length(Q.HistoricoCustos)=3,'apurações persistem'); Check(Q.OrcamentoFixado and (Q.CustoPrevistoProjeto=15000),'orçamento fixo persiste');
  O:=PLProjetoParaJSON(P); try O.Arrays['sprints'].Objects[0].Arrays['tasks'].Objects[0].Delete('task_id'); O.Arrays['sprints'].Objects[0].Arrays['tasks'].Objects[0].Add('task_id','inexistente'); L.Text:=O.AsJSON; L.SaveToFile(Path+'.json'); finally O.Free; end;
  Failed:=False; try PLCarregarProjeto(Q,Path+'.json'); except on Ex: Exception do Failed:=True; end; Check(Failed,'referência órfã de sprint recusada'); Check(Q.Sprints[0].Contem(A.ID),'falha preserva projeto ativo');
  O:=PLProjetoParaJSON(P); try O.Arrays['historico_custos'].Objects[0].Delete('computed_cents'); O.Arrays['historico_custos'].Objects[0].Add('computed_cents',-1); L.Text:=O.AsJSON; L.SaveToFile(Path+'.json'); finally O.Free; end;
  Failed:=False; try PLCarregarProjeto(Q,Path+'.json'); except on Ex: Exception do Failed:=True; end; Check(Failed,'histórico negativo recusado sem substituir projeto');
  O:=PLProjetoParaJSON(P); try O.Arrays['historico_custos'].Objects[1].Delete('date'); O.Arrays['historico_custos'].Objects[1].Add('date',PLDataISO(P.HistoricoCustos[0].Data)); L.Text:=O.AsJSON; L.SaveToFile(Path+'.json'); finally O.Free; end;
  Failed:=False; try PLCarregarProjeto(Q,Path+'.json'); except on Ex: Exception do Failed:=True; end; Check(Failed,'data de apuração duplicada recusada');
  Failed:=False; try P.RegistrarCustos(0); except on Ex: Exception do Failed:=True; end; Check(Failed,'apuração sem data recusada');
  Failed:=False; try P.NovaSprint('',Day+30,Day+35); except on Ex: Exception do Failed:=True; end; Check(Failed,'sprint sem nome recusada');
  O:=PLProjetoParaJSON(P); try O.Delete('sprints'); O.Delete('historico_custos'); O.Objects['projeto'].Delete('orcamento_fixado'); O.Objects['projeto'].Delete('orcamento_centavos'); O.Delete('schema_version'); O.Add('schema_version','1.0'); PLProjetoDeJSON(Q,O); finally O.Free; end;
  Check((Q.Sprints.Count=0) and (Length(Q.HistoricoCustos)=0) and not Q.OrcamentoFixado,'projeto antigo abre sem fabricar sprints ou histórico');
  PLAlterarStatus(P,A,plsAFazer); Check(A.Progresso=0,'reabrir tarefa no TO-DO redefine progresso'); PLAlterarStatus(P,A,plsEmAndamento); Check((A.Progresso>0) and (A.Progresso<100),'iniciar tarefa mantém progresso coerente');
  P.RegistrarCustos(D1-1); Check(P.HistoricoCustos[0].Data=D1-1,'apuração retroativa explícita fica ordenada');
  P.Sprints.Delete(1); Check((P.Count=6) and (P.Sprints.Count=1),'excluir sprint não exclui tarefas');
  WriteLn(Checks,' verificacoes de sprints, TO-DO e custos semanais, 0 falhas');
 finally DeleteFile(Path+'.html'); DeleteFile(Path+'.csv'); DeleteFile(Path+'.json'); L.Free; C.Free; Q.Free; P.Free; end;
end.
