program test_recursos;
{$mode objfpc}{$H+}{$codepage utf8}
uses Classes,SysUtils,DateUtils,Math,fpjson,ea_links,ea_money,ea_fileio,
 plan_recursos,plan_tipos,plan_documento,plan_cronograma,plan_json;
var P,Q: TPLProjeto; C: TPLCronograma; A,B,Dummy: TPLTarefa; R,M,F: TPLRecurso;
 Data: TPLAlocacoes; Files: TJSONArray; O,FileObj: TJSONObject; G: TGUID;
 Path,Original: string; Failed: Boolean; Checks,I: Integer; Day: TDateTime; L: TStringList;
procedure Check(Value: Boolean; const S: string);
begin Inc(Checks); if not Value then raise Exception.Create(S); end;
function Resource(const Name: string; Kind: TPLRecursoTipo): TPLRecurso;
begin Result:=P.NovoRecurso; Result.Nome:=Name; Result.Tipo:=Kind; if Kind=prtArquivo then Result.Link:='https://exemplo.org/projeto'; P.AdicionarRecurso(Result); end;
procedure SetAllocation(T: TPLTarefa; Res: TPLRecurso; Units: Double; Direction: TPLDirecao; Price: Int64; Accounted: Boolean);
var N: Integer; Allocations: TPLAlocacoes;
begin Allocations:=Copy(T.Alocacoes); N:=Length(Allocations); SetLength(Allocations,N+1); Allocations[N].RecursoID:=Res.ID; Allocations[N].Unidades:=Units; Allocations[N].Direcao:=Direction; Allocations[N].CustoUnitarioCentavos:=Price; Allocations[N].Contabilizado:=Accounted; P.DefinirAlocacoes(T,Allocations); end;
procedure AddFile(const Name,Link,Direction: string);
begin FileObj:=TJSONObject.Create; FileObj.Add('name',Name); FileObj.Add('link',Link); FileObj.Add('direction',Direction); Files.Add(FileObj); end;
begin
 DefaultSystemCodePage:=CP_UTF8; SetMultiByteConversionCodePage(CP_UTF8);
 P:=TPLProjeto.Create; Q:=TPLProjeto.Create; C:=TPLCronograma.Create; Files:=TJSONArray.Create; L:=TStringList.Create;
 CreateGUID(G); Path:=GetTempDir(False)+'ea-recursos-'+GUIDToString(G)+'.plan.json'; Checks:=0;
 try
  Day:=EncodeDate(2026,11,9); P.Novo('Recursos e custos',Day); P.Calendario.Clear; P.Calendario.SetStandard;
  A:=P.NovaTarefa('Tarefa A'); B:=P.NovaTarefa('Tarefa B');
  Check(P.CustoProjeto=0,'tarefas sem recursos ou custos são válidas');
  C.Calcular(P); Check(C.Valido,'projeto sem recursos calcula');
  R:=Resource('Arquiteta',prtPessoa); R.UsuarioID:='user-arquiteta';
  SetAllocation(A,R,0.5,prdUso,2000,True); SetAllocation(B,R,0.5,prdUso,2000,True);
  C.Calcular(P); Check(C.Valido,'múltiplas alocações calculam'); Check(not C.Conflito[0] and not C.Conflito[1],'duas meias dedicações cabem em 100%');
  Data:=Copy(B.Alocacoes); Data[0].Unidades:=0.75; P.DefinirAlocacoes(B,Data); C.Calcular(P);
  Check(C.Conflito[0] and C.Conflito[1],'125% gera sobrecarga nas duas tarefas');
  R.Capacidade:=2; C.Calcular(P); Check(not C.Conflito[0],'capacidade de 200% aceita 125%'); R.Capacidade:=1;
  B.InicioSolicitado:=Day+1; C.Calcular(P); Check(not C.Conflito[0] and not C.Conflito[1],'datas sucessivas sem sobrecarga');
  R.DisponivelDe:=Day+1; C.Calcular(P); Check(C.Conflito[0] and not C.Conflito[1],'início antes da disponibilidade é sinalizado'); R.DisponivelDe:=0;
  R.DisponivelAte:=Day; C.Calcular(P); Check(C.Conflito[1],'tarefa após disponibilidade é sinalizada'); R.DisponivelAte:=0;
  SetLength(R.Ausencias,1); R.Ausencias[0].De:=Day; R.Ausencias[0].Ate:=Day; C.Calcular(P); Check(C.Conflito[0],'férias ou afastamento sinalizam indisponibilidade'); SetLength(R.Ausencias,0);
  R.CalendarioProjeto:=False; R.Calendario.Clear; R.Calendario.SetWeekDay(2,[480,720]); C.Calcular(P); Check(C.Conflito[0],'jornada parcial incompatível é sinalizada'); R.CalendarioProjeto:=True;
  M:=Resource('Papel A3',prtMaterial); M.PrecoCentavos:=250;
  SetAllocation(A,M,3,prdEntrada,250,True); Check(P.CustoTarefa(A)=8750,'trabalho 4h e consumível 3 unidades somados');
  SetLength(A.Custos,2); A.Custos[0].Nome:='Serviço complementar'; A.Custos[0].Quantidade:=2; A.Custos[0].ValorUnitarioCentavos:=1250; A.Custos[0].Contabilizado:=True;
  A.Custos[1].Nome:='Despesa ainda não contabilizada'; A.Custos[1].Quantidade:=1; A.Custos[1].ValorUnitarioCentavos:=3000; A.Custos[1].Contabilizado:=False;
  Check(P.CustoTarefa(A)=11250,'saída soma custos diretos e recursos contabilizados');
  Check(P.CustoTarefa(A,False)=14250,'previsto inclui componentes pendentes');
  Check(P.CustoProjeto=P.CustoTarefa(A)+P.CustoTarefa(B),'saída do projeto agrega tarefas sem duplicar');
  M.PrecoCentavos:=9999; Check(P.CustoTarefa(A)=11250,'preço alocado é preservado após mudar catálogo');
  Data:=Copy(A.Alocacoes); Data[1].Contabilizado:=False; P.DefinirAlocacoes(A,Data);
  Check(P.CustoTarefa(A)=10500,'consumível não contabilizado não compõe saída'); Data[1].Contabilizado:=True; P.DefinirAlocacoes(A,Data);
  Failed:=False; Data:=Copy(A.Alocacoes); Data[1].Direcao:=prdSaida; try P.DefinirAlocacoes(A,Data); except on E: Exception do Failed:=True; end; Check(Failed,'consumível nunca pode ser recurso de saída');
  Failed:=False; Data[1].Direcao:=prdUso; try P.DefinirAlocacoes(A,Data); except on E: Exception do Failed:=True; end; Check(Failed,'consumível precisa ser entrada');
  Failed:=False; Data:=Copy(A.Alocacoes); Data[0].RecursoID:='inexistente'; try P.DefinirAlocacoes(A,Data); except on E: Exception do Failed:=True; end; Check(Failed,'alocação órfã recusada');
  Failed:=False; Data:=Copy(A.Alocacoes); Data[0].Unidades:=-1; try P.DefinirAlocacoes(A,Data); except on E: Exception do Failed:=True; end; Check(Failed,'alocação negativa recusada');
  Failed:=False; Data:=Copy(A.Alocacoes); SetLength(Data,3); Data[2]:=Data[0]; try P.DefinirAlocacoes(A,Data); except on E: Exception do Failed:=True; end; Check(Failed,'alocação repetida recusada');
  Failed:=False; try P.ExcluirRecurso(P.RecursoIndice(R.ID)); except on E: Exception do Failed:=True; end; Check(Failed,'exclusão de recurso em uso recusada');
  AddFile('Programa de necessidades','docs/programa.pdf','input'); AddFile('Entrega CAD','entrega/planta.eacad','output');
  P.ImportarArquivos(A,Files); Check(Length(A.Alocacoes)=4,'entrada e saída vinculadas na tarefa');
  P.ImportarArquivos(A,Files); Check(Length(A.Alocacoes)=4,'importação de arquivos é idempotente');
  Check(P.CustoTarefa(A)=11250,'vínculos de arquivos não duplicam custo');
  O:=PLProjetoParaJSON(P);
  try
   Check(O.Get('custo_saida_centavos',Int64(-1))=P.CustoProjeto,'saída calculada publicada em JSON');
   O.Delete('custo_saida_centavos'); O.Add('custo_saida_centavos',Int64(999999)); PLProjetoDeJSON(Q,O);
  finally O.Free; end;
  Check(Q.CustoProjeto=P.CustoProjeto,'total de saída é recalculado, não confiado ao arquivo');
  Check(Q.Recursos.Count=P.Recursos.Count,'catálogo de recursos preservado');
  Check(Length(Q[0].Alocacoes)=4,'alocações preservadas'); Check(Length(Q[0].Custos)=2,'composição de custos preservada');
  Check(Q[0].Custos[1].Contabilizado=False,'estado de contabilização preservado');
  Check(Q.Recursos[1].PrecoCentavos=9999,'preço do catálogo preservado');
  Check(Q[0].Alocacoes[1].CustoUnitarioCentavos=250,'preço alocado preservado independentemente');
  Files.Free; Files:=P.ArquivosTarefa(A,Path); Check(Files.Count=2,'exporta arquivos opcionais');
  Check(Pos(ExtractFilePath(Path),Files.Objects[0].Get('link',''))=1,'arquivo relativo resolve em relação ao projeto');
  Check(Files.Objects[1].Get('direction','')='output','direção de saída preservada');
  Files.Delete(0); P.DefinirArquivos(A,Files); Check(Length(A.Alocacoes)=3,'remover arquivo preserva recursos de trabalho e consumíveis');
  Files.Clear; P.DefinirArquivos(A,Files); Check(Length(A.Alocacoes)=2,'todos os arquivos podem ser removidos');
  AddFile('Entrega futura','C:\projetos\nao-existe.eacad','output'); P.DefinirArquivos(A,Files); Check(Length(A.Alocacoes)=3,'saída prevista não precisa existir');
  Check(not EAValidLink('javascript:alert(1)'),'esquema executável recusado'); Check(not EAValidLink('https://user:password@example.org'),'credenciais embutidas recusadas'); Check(EAValidLink('https://example.org/input.pdf'),'URL HTTPS aceita'); Check(EAValidLink('../dados/arquivo.pdf'),'caminho relativo aceito');
  Check(EAMoneyParse('R$ 1.234,56')=123456,'valor brasileiro convertido em centavos'); Check(EAMoneyParse('12.34')=1234,'ponto decimal aceito');
  Check(EALineCost(1.005,100)=101,'arredondamento de quantidade decimal com representação binária');
  Check(EALineCost(0.015,100)=2,'meio centavo em quantidade fracionária');
  Check(EALineCost(0.5,1)=1,'arredondamento monetário para centavo'); Check(EALineCost(3,10)=30,'soma monetária sem perda decimal');
  Failed:=False; try EAMoneyParse('-1,00'); except on E: Exception do Failed:=True; end; Check(Failed,'valor negativo recusado');
  Dummy:=TPLTarefa.Create('',''); try Dummy.Assign(A); Dummy.Alocacoes[0].Unidades:=1; Check(A.Alocacoes[0].Unidades=0.5,'cópia de alocação independente'); Dummy.Custos[0].Quantidade:=3; Check(A.Custos[0].Quantidade=2,'cópia de custos independente'); finally Dummy.Free; end;
  SetLength(R.Ausencias,1); R.Ausencias[0].De:=Day+10; R.Ausencias[0].Ate:=Day+12; R.DisponivelDe:=Day; R.DisponivelAte:=Day+60;
  PLSalvarProjeto(P,Path); PLCarregarProjeto(Q,Path); Check(Length(Q.Recursos[0].Ausencias)=1,'ausências persistem'); Check(Q.Recursos[0].DisponivelAte=Day+60,'disponibilidade persiste');
  O:=PLProjetoParaJSON(P); try O.Arrays['recursos'].Objects[0].Delete('capacity'); O.Arrays['recursos'].Objects[0].Add('capacity',-1); L.Text:=O.AsJSON; L.SaveToFile(Path); finally O.Free; end;
  Original:=Q.Nome; Failed:=False; try PLCarregarProjeto(Q,Path); except on E: Exception do Failed:=True; end;
  Check(Failed,'recurso inválido no arquivo recusado'); Check(Q.Nome=Original,'falha de leitura preserva projeto ativo');
  WriteLn(Checks,' verificacoes de recursos, arquivos e custos, 0 falhas');
 finally Files.Free; L.Free; C.Free; Q.Free; P.Free; DeleteFile(Path); end;
end.
